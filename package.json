{
  "name": "estudiocontable",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/security-headers.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "news:scan": "node scripts/news-scan.mjs",
    "test:news": "node --test server/news.test.mjs",
    "test:security": "node --test server/security.test.mjs",
    "test": "node --test server/*.test.mjs",
    "audit:security": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.6",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.562.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.7"
  }
}
