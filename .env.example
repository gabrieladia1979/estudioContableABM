# Crear una propiedad GA4 y copiar aquí el ID de medición G-... cuando exista.
# En Netlify, configurar esta variable en Project configuration > Environment variables.
VITE_GA_MEASUREMENT_ID=

# Noticias: solo servidor. Nunca agregar el prefijo VITE_ a estas claves.
# Clave privada para entrar a /editor-noticias en producción (mínimo 32 caracteres).
NEWS_ADMIN_TOKEN=
# Elegir un modelo habilitado en la cuenta de API. La búsqueda funciona sin IA.
OPENAI_API_KEY=
NEWS_AI_MODEL=
# Activar la consulta programada de fuentes al desplegar en Netlify.
NEWS_SCAN_ENABLED=false
