# Crear una propiedad GA4 y copiar aquí el ID de medición G-... cuando exista.
# En Netlify, configurar esta variable en Project configuration > Environment variables.
VITE_GA_MEASUREMENT_ID=

# Noticias: solo servidor. Nunca agregar el prefijo VITE_ a estas claves.
# Clave privada para entrar a /editor-noticias en producción (mínimo 32 caracteres).
NEWS_ADMIN_TOKEN=

# Opcional: vencimiento de la clave de ingreso en formato ISO 8601 (UTC).
# Cambiar la clave invalida todas las sesiones. Las sesiones duran 30 minutos.
NEWS_ADMIN_TOKEN_EXPIRES_AT=

# Inteligencia Artificial para redacción de noticias:
# Podés usar OpenAI (recomendado gpt-4o-mini) o Google Gemini (GEMINI_API_KEY)
OPENAI_API_KEY=
NEWS_AI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Máximo de solicitudes de redacción por día UTC para todo el sitio (1–1000).
NEWS_AI_DAILY_LIMIT=20

# Activar la consulta programada de fuentes al desplegar en Netlify (09:00 y 21:00 hs de Bs. As.)
NEWS_SCAN_ENABLED=true

# Publicación 100% automática de notas destacadas de Blog del Contador y ARCA:
# Si es true, el escáner redacta con IA y publica directamente sin esperar aprobación manual.
NEWS_AUTO_PUBLISH=true
